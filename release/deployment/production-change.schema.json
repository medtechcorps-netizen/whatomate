{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rereply.app/schemas/production-phase-state-v1.json",
  "title": "ReReply signed production phase state",
  "$ref": "#/$defs/phaseState",
  "$defs": {
    "sha1": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "runId": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,14}$"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "phase": {
      "enum": [
        "baseline",
        "bridge",
        "backend",
        "ui"
      ]
    },
    "state": {
      "enum": [
        "genesis",
        "baseline",
        "bridge",
        "backend",
        "ui"
      ]
    },
    "operation": {
      "enum": [
        "activate",
        "rollback"
      ]
    },
    "imageWeb": {
      "type": "object",
      "additionalProperties": false,
      "x-rereply-subject-template": "ghcr.io/medtechcorps-netizen/rereply-release-web@{digest}",
      "required": [
        "component",
        "repository",
        "digest",
        "subject"
      ],
      "properties": {
        "component": {
          "const": "web"
        },
        "repository": {
          "const": "ghcr.io/medtechcorps-netizen/rereply-release-web"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "subject": {
          "type": "string",
          "pattern": "^ghcr\\.io/medtechcorps-netizen/rereply-release-web@sha256:[0-9a-f]{64}$"
        }
      }
    },
    "imageMetaRelay": {
      "type": "object",
      "additionalProperties": false,
      "x-rereply-subject-template": "ghcr.io/medtechcorps-netizen/rereply-release-meta-relay@{digest}",
      "required": [
        "component",
        "repository",
        "digest",
        "subject"
      ],
      "properties": {
        "component": {
          "const": "meta-relay"
        },
        "repository": {
          "const": "ghcr.io/medtechcorps-netizen/rereply-release-meta-relay"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "subject": {
          "type": "string",
          "pattern": "^ghcr\\.io/medtechcorps-netizen/rereply-release-meta-relay@sha256:[0-9a-f]{64}$"
        }
      }
    },
    "imageGmailRelay": {
      "type": "object",
      "additionalProperties": false,
      "x-rereply-subject-template": "ghcr.io/medtechcorps-netizen/rereply-release-gmail-relay@{digest}",
      "required": [
        "component",
        "repository",
        "digest",
        "subject"
      ],
      "properties": {
        "component": {
          "const": "gmail-relay"
        },
        "repository": {
          "const": "ghcr.io/medtechcorps-netizen/rereply-release-gmail-relay"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "subject": {
          "type": "string",
          "pattern": "^ghcr\\.io/medtechcorps-netizen/rereply-release-gmail-relay@sha256:[0-9a-f]{64}$"
        }
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed_targets",
        "forbidden_targets"
      ],
      "properties": {
        "allowed_targets": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/phase"
          }
        },
        "forbidden_targets": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/phase"
          }
        }
      }
    },
    "artifactBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "run_attempt",
        "artifact_id",
        "artifact_name",
        "artifact_digest",
        "sha256"
      ],
      "properties": {
        "run_id": {"$ref": "#/$defs/runId"},
        "run_attempt": {"const": 1},
        "artifact_id": {"$ref": "#/$defs/runId"},
        "artifact_name": {"type": "string", "minLength": 1, "maxLength": 256},
        "artifact_digest": {"$ref": "#/$defs/digest"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "phaseState": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "lineage": {
                "properties": {
                  "phase": {
                    "const": "baseline"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "rollback": {
                "const": {
                  "allowed_targets": [],
                  "forbidden_targets": []
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "lineage": {
                "properties": {
                  "phase": {
                    "const": "bridge"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "rollback": {
                "const": {
                  "allowed_targets": [
                    "baseline"
                  ],
                  "forbidden_targets": []
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "lineage": {
                "properties": {
                  "phase": {
                    "const": "backend"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "rollback": {
                "const": {
                  "allowed_targets": [
                    "bridge"
                  ],
                  "forbidden_targets": [
                    "baseline"
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "lineage": {
                "properties": {
                  "phase": {
                    "const": "ui"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "rollback": {
                "const": {
                  "allowed_targets": [
                    "backend",
                    "bridge"
                  ],
                  "forbidden_targets": [
                    "baseline"
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "required": ["schema_version"],
            "properties": {"schema_version": {"const": 1}}
          },
          "then": {
            "properties": {
              "lineage": {
                "allOf": [
                  {
                    "if": {
                      "required": ["operation"],
                      "properties": {"operation": {"const": "activate"}}
                    },
                    "then": {
                      "properties": {
                        "predecessor_kind": {
                          "enum": ["apply-receipt", "reconciliation-receipt"]
                        }
                      }
                    }
                  },
                  {
                    "if": {
                      "required": ["operation"],
                      "properties": {"operation": {"const": "rollback"}}
                    },
                    "then": {
                      "properties": {
                        "predecessor_kind": {
                          "enum": [
                            "rollback-receipt",
                            "orphan-rollback-receipt",
                            "reconciliation-receipt"
                          ]
                        }
                      }
                    }
                  }
                ]
              },
              "evidence": {
                "not": {
                  "anyOf": [
                    {"required": ["change_receipt_binding"]},
                    {"required": ["main_lock_release_reconciliation_binding"]}
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "required": ["schema_version"],
            "properties": {"schema_version": {"const": 2}}
          },
          "then": {
            "properties": {
              "lineage": {
                "properties": {
                  "predecessor_kind": {
                    "enum": ["apply-reconciled-receipt", "rollback-reconciled-receipt"]
                  }
                }
              },
              "evidence": {
                "required": [
                  "change_receipt_binding",
                  "main_lock_release_reconciliation_binding"
                ]
              }
            }
          }
        }
      ],
      "required": [
        "schema_version",
        "authority",
        "repository",
        "completed_at",
        "control",
        "lineage",
        "provider_state",
        "evidence",
        "gates",
        "rollback"
      ],
      "properties": {
        "schema_version": {"enum": [1, 2]},
        "authority": {
          "const": "production-phase-state"
        },
        "repository": {
          "const": "medtechcorps-netizen/whatomate"
        },
        "completed_at": {
          "$ref": "#/$defs/timestamp"
        },
        "control": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "workflow_sha",
            "workflow_path",
            "run_id",
            "run_attempt",
            "runner_environment",
            "release_policy_sha256",
            "change_schema_sha256"
          ],
          "properties": {
            "workflow_sha": {
              "$ref": "#/$defs/sha1"
            },
            "workflow_path": {
              "const": ".github/workflows/verify-production-crm-canary.yml"
            },
            "run_id": {
              "$ref": "#/$defs/runId"
            },
            "run_attempt": {
              "$ref": "#/$defs/attempt"
            },
            "runner_environment": {
              "const": "github-hosted"
            },
            "release_policy_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "change_schema_sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        "lineage": {
          "type": "object",
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "required": [
                  "operation"
                ],
                "properties": {
                  "operation": {
                    "const": "activate"
                  }
                }
              },
              "then": {
                "properties": {
                  "predecessor_kind": {
                    "enum": [
                      "apply-receipt",
                      "apply-reconciled-receipt",
                      "reconciliation-receipt"
                    ]
                  }
                }
              }
            },
            {
              "if": {
                "required": [
                  "operation"
                ],
                "properties": {
                  "operation": {
                    "const": "rollback"
                  }
                }
              },
              "then": {
                "properties": {
                  "predecessor_kind": {
                    "enum": [
                      "rollback-receipt",
                      "rollback-reconciled-receipt",
                      "orphan-rollback-receipt",
                      "reconciliation-receipt"
                    ]
                  }
                }
              }
            }
          ],
          "required": [
            "event_sequence",
            "phase_ordinal",
            "operation",
            "from",
            "to",
            "predecessor_kind",
            "predecessor_state_sha256",
            "phase",
            "phase_source_sha"
          ],
          "properties": {
            "event_sequence": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            },
            "phase_ordinal": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4
            },
            "operation": {
              "$ref": "#/$defs/operation"
            },
            "from": {
              "$ref": "#/$defs/state"
            },
            "to": {
              "$ref": "#/$defs/phase"
            },
            "predecessor_kind": {
              "enum": [
                "apply-receipt",
                "apply-reconciled-receipt",
                "rollback-receipt",
                "rollback-reconciled-receipt",
                "orphan-rollback-receipt",
                "reconciliation-receipt"
              ]
            },
            "predecessor_state_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "phase": {
              "$ref": "#/$defs/phase"
            },
            "phase_source_sha": {
              "$ref": "#/$defs/sha1"
            }
          }
        },
        "provider_state": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "app_identity_sha256",
            "default_ingress_sha256",
            "app_updated_at_sha256",
            "active_deployment_identity_sha256",
            "canonical_spec_sha256",
            "environment_values_sha256",
            "non_source_projection_sha256",
            "source_mode",
            "images"
          ],
          "properties": {
            "app_identity_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "default_ingress_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "app_updated_at_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "active_deployment_identity_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "canonical_spec_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "environment_values_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "non_source_projection_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "source_mode": {
              "const": "digest-images"
            },
            "images": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "uniqueItems": true,
              "prefixItems": [
                {
                  "$ref": "#/$defs/imageWeb"
                },
                {
                  "$ref": "#/$defs/imageMetaRelay"
                },
                {
                  "$ref": "#/$defs/imageGmailRelay"
                }
              ],
              "items": false
            }
          }
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "rollout_plan_sha256",
            "production_plan_sha256",
            "recovery_sha256",
            "change_receipt_sha256",
            "canary_sha256"
          ],
          "properties": {
            "rollout_plan_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "production_plan_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "recovery_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "change_receipt_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "canary_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "change_receipt_binding": {
              "$ref": "#/$defs/artifactBinding"
            },
            "main_lock_release_reconciliation_binding": {
              "$ref": "#/$defs/artifactBinding"
            }
          }
        },
        "gates": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "deployment_succeeded",
            "migration_succeeded",
            "canary_succeeded"
          ],
          "properties": {
            "deployment_succeeded": {
              "const": true
            },
            "migration_succeeded": {
              "const": true
            },
            "canary_succeeded": {
              "const": true
            }
          }
        },
        "rollback": {
          "$ref": "#/$defs/rollback"
        }
      }
    }
  }
}
