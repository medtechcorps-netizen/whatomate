{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rereply.app/schemas/production-main-lock-proof-v1.json",
  "title": "ReReply production main lock proof",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "authority",
    "repository",
    "created_at",
    "control",
    "operation",
    "mutation_intent",
    "root_acquire_intent",
    "branch",
    "acquisition"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "authority": {
      "const": "production-main-lock-proof"
    },
    "repository": {
      "const": "medtechcorps-netizen/whatomate"
    },
    "created_at": {
      "$ref": "#/$defs/timestamp"
    },
    "control": {
      "$ref": "#/$defs/control"
    },
    "operation": {
      "enum": [
        "apply",
        "rollback",
        "orphan-rollback"
      ]
    },
    "mutation_intent": {
      "$ref": "#/$defs/artifactBinding"
    },
    "root_acquire_intent": {
      "$ref": "#/$defs/artifactBinding"
    },
    "branch": {
      "$ref": "#/$defs/branch"
    },
    "acquisition": {
      "$ref": "#/$defs/acquisition"
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "operation"
        ],
        "properties": {
          "operation": {
            "const": "apply"
          }
        }
      },
      "then": {
        "properties": {
          "control": {
            "properties": {
              "workflow_path": {
                "const": ".github/workflows/apply-production-phase.yml"
              }
            }
          },
          "branch": {
            "properties": {
              "strategy": {
                "const": "acquire"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "operation"
        ],
        "properties": {
          "operation": {
            "const": "rollback"
          }
        }
      },
      "then": {
        "properties": {
          "control": {
            "properties": {
              "workflow_path": {
                "const": ".github/workflows/rollback-production-phase.yml"
              }
            }
          },
          "branch": {
            "properties": {
              "strategy": {
                "const": "acquire"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "operation"
        ],
        "properties": {
          "operation": {
            "const": "orphan-rollback"
          }
        }
      },
      "then": {
        "properties": {
          "control": {
            "properties": {
              "workflow_path": {
                "const": ".github/workflows/rollback-production-orphan.yml"
              }
            }
          },
          "branch": {
            "properties": {
              "strategy": {
                "const": "inherit"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "branch"
        ],
        "properties": {
          "branch": {
            "required": [
              "strategy"
            ],
            "properties": {
              "strategy": {
                "const": "acquire"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "branch": {
            "properties": {
              "pre_lock": {
                "$ref": "#/$defs/unlockedProjection"
              },
              "post_lock": {
                "$ref": "#/$defs/lockedProjection"
              }
            }
          },
          "acquisition": {
            "properties": {
              "graphql_operations_used": {
                "const": [
                  "query",
                  "mutation",
                  "query"
                ]
              },
              "mutation_request_count": {
                "const": 1
              },
              "outcome": {
                "enum": [
                  "applied",
                  "ambiguous-reconciled"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "branch"
        ],
        "properties": {
          "branch": {
            "required": [
              "strategy"
            ],
            "properties": {
              "strategy": {
                "const": "inherit"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "branch": {
            "properties": {
              "pre_lock": {
                "$ref": "#/$defs/lockedProjection"
              },
              "post_lock": {
                "$ref": "#/$defs/lockedProjection"
              }
            }
          },
          "acquisition": {
            "properties": {
              "graphql_operations_used": {
                "const": [
                  "query"
                ]
              },
              "mutation_request_count": {
                "const": 0
              },
              "outcome": {
                "const": "already-locked-inherited"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha1": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "runId": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,14}$"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "artifactBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "run_attempt",
        "artifact_id",
        "artifact_name",
        "artifact_digest",
        "sha256"
      ],
      "properties": {
        "run_id": {
          "$ref": "#/$defs/runId"
        },
        "run_attempt": {
          "$ref": "#/$defs/attempt"
        },
        "artifact_id": {
          "$ref": "#/$defs/runId"
        },
        "artifact_name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,254}$"
        },
        "artifact_digest": {
          "$ref": "#/$defs/digest"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflow_sha",
        "workflow_path",
        "run_id",
        "run_attempt",
        "runner_environment"
      ],
      "properties": {
        "workflow_sha": {
          "$ref": "#/$defs/sha1"
        },
        "workflow_path": {
          "enum": [
            ".github/workflows/apply-production-phase.yml",
            ".github/workflows/rollback-production-phase.yml",
            ".github/workflows/rollback-production-orphan.yml"
          ]
        },
        "run_id": {
          "$ref": "#/$defs/runId"
        },
        "run_attempt": {
          "const": 1
        },
        "runner_environment": {
          "const": "github-hosted"
        }
      }
    },
    "lockProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lock_branch",
        "is_admin_enforced",
        "lock_allows_fetch_and_merge"
      ],
      "properties": {
        "lock_branch": {
          "type": "boolean"
        },
        "is_admin_enforced": {
          "const": true
        },
        "lock_allows_fetch_and_merge": {
          "const": false
        }
      }
    },
    "unlockedProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lock_branch",
        "is_admin_enforced",
        "lock_allows_fetch_and_merge"
      ],
      "properties": {
        "lock_branch": {
          "const": false
        },
        "is_admin_enforced": {
          "const": true
        },
        "lock_allows_fetch_and_merge": {
          "const": false
        }
      }
    },
    "lockedProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lock_branch",
        "is_admin_enforced",
        "lock_allows_fetch_and_merge"
      ],
      "properties": {
        "lock_branch": {
          "const": true
        },
        "is_admin_enforced": {
          "const": true
        },
        "lock_allows_fetch_and_merge": {
          "const": false
        }
      }
    },
    "branch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "main_sha",
        "rule_id",
        "rule_identity_sha256",
        "strategy",
        "pre_lock",
        "post_lock"
      ],
      "properties": {
        "main_sha": {
          "$ref": "#/$defs/sha1"
        },
        "rule_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_+/=-]+$",
          "maxLength": 512
        },
        "rule_identity_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "strategy": {
          "enum": [
            "acquire",
            "inherit"
          ]
        },
        "pre_lock": {
          "$ref": "#/$defs/lockProjection"
        },
        "post_lock": {
          "$ref": "#/$defs/lockedProjection"
        }
      }
    },
    "acquisition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "http_methods_used",
        "graphql_operations_used",
        "mutation_request_count",
        "outcome",
        "mutation_fingerprint_sha256",
        "read_confirmed"
      ],
      "properties": {
        "http_methods_used": {
          "const": [
            "POST"
          ]
        },
        "graphql_operations_used": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": false,
          "items": {
            "enum": [
              "query",
              "mutation"
            ]
          }
        },
        "mutation_request_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "outcome": {
          "enum": [
            "applied",
            "ambiguous-reconciled",
            "already-locked-inherited"
          ]
        },
        "mutation_fingerprint_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "read_confirmed": {
          "const": true
        }
      }
    }
  }
}
