{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rereply.app/schemas/production-main-lock-release-reconciliation-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "authority", "repository", "completed_at", "state", "operation", "control", "source", "branch", "authorities", "observations", "request_ledger", "http_request_count", "graphql_query_count", "branch_mutation_request_count", "mutation_text_present", "gates", "mutation_request_count", "canary_eligible"],
  "properties": {
    "schema_version": {"const": 1},
    "authority": {"const": "production-main-lock-release-reconciliation"},
    "repository": {"const": "medtechcorps-netizen/whatomate"},
    "completed_at": {"$ref": "production-main-lock-release-failure-assertion.schema.json#/$defs/timestamp"},
    "state": {"const": "observed-unlocked-after-incomplete-normal-release"},
    "operation": {"enum": ["apply", "rollback"]},
    "control": {"$ref": "production-main-lock-release-failure-assertion.schema.json#/$defs/control"},
    "source": {"$ref": "production-main-lock-release-failure-assertion.schema.json#/$defs/source"},
    "branch": {"$ref": "#/$defs/branch"},
    "authorities": {"type": "object", "additionalProperties": false, "required": ["failure_assertion", "release_authorization", "original_receipt"], "properties": {"failure_assertion": {"$ref": "production-main-lock-release-failure-assertion.schema.json#/$defs/authority"}, "release_authorization": {"$ref": "production-main-lock-release-failure-assertion.schema.json#/$defs/authority"}, "original_receipt": {"$ref": "production-main-lock-release-failure-assertion.schema.json#/$defs/authority"}}},
    "observations": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/observation"}},
    "request_ledger": {"type": "array", "minItems": 9, "maxItems": 9, "items": {"$ref": "#/$defs/ledger"}},
    "http_request_count": {"const": 9},
    "graphql_query_count": {"const": 3},
    "branch_mutation_request_count": {"const": 0},
    "mutation_text_present": {"const": false},
    "gates": {"type": "object", "additionalProperties": false, "required": ["source_attempt_one", "source_terminal_failure", "pre_unlock_jobs_succeeded", "unlock_sole_incomplete_terminal_job", "exact_artifacts_verified", "dual_attested_release_authorization_verified", "dual_attested_original_receipt_verified", "main_unchanged", "unique_rule_observed_unlocked", "read_only"], "properties": {"source_attempt_one": {"const": true}, "source_terminal_failure": {"const": true}, "pre_unlock_jobs_succeeded": {"const": true}, "unlock_sole_incomplete_terminal_job": {"const": true}, "exact_artifacts_verified": {"const": true}, "dual_attested_release_authorization_verified": {"const": true}, "dual_attested_original_receipt_verified": {"const": true}, "main_unchanged": {"const": true}, "unique_rule_observed_unlocked": {"const": true}, "read_only": {"const": true}}},
    "mutation_request_count": {"const": 0},
    "canary_eligible": {"const": true}
  },
  "$defs": {
    "sha1": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "projection": {"type": "object", "additionalProperties": false, "required": ["lock_branch", "is_admin_enforced", "lock_allows_fetch_and_merge"], "properties": {"lock_branch": {"type": "boolean"}, "is_admin_enforced": {"const": true}, "lock_allows_fetch_and_merge": {"const": false}}},
    "branch": {"type": "object", "additionalProperties": false, "required": ["main_sha", "rule_id", "rule_identity_sha256", "expected_before", "observed_after"], "properties": {"main_sha": {"$ref": "#/$defs/sha1"}, "rule_id": {"type": "string", "pattern": "^[A-Za-z0-9_+/=-]{1,512}$"}, "rule_identity_sha256": {"$ref": "#/$defs/sha256"}, "expected_before": {"allOf": [{"$ref": "#/$defs/projection"}, {"properties": {"lock_branch": {"const": true}}}]}, "observed_after": {"allOf": [{"$ref": "#/$defs/projection"}, {"properties": {"lock_branch": {"const": false}}}]}}},
    "observation": {"type": "object", "additionalProperties": false, "required": ["round", "observed_at", "main_sha", "rule_id", "lock_branch", "is_admin_enforced", "lock_allows_fetch_and_merge", "http_method", "api_operation"], "properties": {"round": {"type": "integer", "minimum": 1, "maximum": 3}, "observed_at": {"$ref": "#/$defs/timestamp"}, "main_sha": {"$ref": "#/$defs/sha1"}, "rule_id": {"type": "string", "pattern": "^[A-Za-z0-9_+/=-]{1,512}$"}, "lock_branch": {"const": false}, "is_admin_enforced": {"const": true}, "lock_allows_fetch_and_merge": {"const": false}, "http_method": {"const": "POST"}, "api_operation": {"const": "graphql-query"}}},
    "ledger": {"type": "object", "additionalProperties": false, "required": ["round", "label", "http_method", "api_operation"], "properties": {"round": {"type": "integer", "minimum": 1, "maximum": 3}, "label": {"enum": ["main-ref-before", "branch-rule", "main-ref-after"]}, "http_method": {"enum": ["GET", "POST"]}, "api_operation": {"enum": ["rest-read", "graphql-query"]}}}
  }
}
