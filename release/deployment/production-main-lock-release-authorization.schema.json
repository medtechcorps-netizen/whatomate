{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rereply.app/schemas/production-main-lock-release-authorization-v1.json",
  "title": "ReReply normal production main-lock release authorization",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "authority", "repository", "issued_at", "expires_at", "state", "operation", "control", "branch", "jobs", "job_inventory_sha256", "artifacts", "artifact_inventory_sha256", "receipt_attestations", "authorization_scope", "static_max_branch_mutations"],
  "properties": {
    "schema_version": {"const": 1},
    "authority": {"const": "production-main-lock-release-authorization"},
    "repository": {"const": "medtechcorps-netizen/whatomate"},
    "issued_at": {"$ref": "#/$defs/timestamp"},
    "expires_at": {"$ref": "#/$defs/timestamp"},
    "state": {"const": "pre-unlock-authorized"},
    "operation": {"enum": ["apply", "rollback"]},
    "control": {"$ref": "#/$defs/control"},
    "branch": {"$ref": "#/$defs/branch"},
    "jobs": {"type": "array", "minItems": 8, "maxItems": 8, "items": {"$ref": "#/$defs/job"}},
    "job_inventory_sha256": {"$ref": "#/$defs/sha256"},
    "artifacts": {"$ref": "#/$defs/artifacts"},
    "artifact_inventory_sha256": {"$ref": "#/$defs/sha256"},
    "receipt_attestations": {"$ref": "#/$defs/receiptAttestations"},
    "authorization_scope": {"const": "release-exact-normal-main-lock-only"},
    "static_max_branch_mutations": {"const": 1}
  },
  "$defs": {
    "sha1": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "runId": {"type": "string", "pattern": "^[1-9][0-9]{0,14}$"},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "control": {
      "type": "object", "additionalProperties": false,
      "required": ["workflow_sha", "workflow_path", "run_id", "run_attempt", "runner_environment", "authorization_schema_sha256", "controller_sha256"],
      "properties": {
        "workflow_sha": {"$ref": "#/$defs/sha1"},
        "workflow_path": {"enum": [".github/workflows/apply-production-phase.yml", ".github/workflows/rollback-production-phase.yml"]},
        "run_id": {"$ref": "#/$defs/runId"},
        "run_attempt": {"const": 1},
        "runner_environment": {"const": "github-hosted"},
        "authorization_schema_sha256": {"$ref": "#/$defs/sha256"},
        "controller_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "branch": {
      "type": "object", "additionalProperties": false,
      "required": ["main_sha", "rule_id", "rule_identity_sha256", "lock_branch", "is_admin_enforced", "lock_allows_fetch_and_merge"],
      "properties": {
        "main_sha": {"$ref": "#/$defs/sha1"},
        "rule_id": {"type": "string", "pattern": "^[A-Za-z0-9_+/=-]{1,512}$"},
        "rule_identity_sha256": {"$ref": "#/$defs/sha256"},
        "lock_branch": {"const": true},
        "is_admin_enforced": {"const": true},
        "lock_allows_fetch_and_merge": {"const": false}
      }
    },
    "job": {
      "type": "object", "additionalProperties": false,
      "required": ["job_id", "name", "status", "conclusion"],
      "properties": {
        "job_id": {"$ref": "#/$defs/runId"},
        "name": {"type": "string", "minLength": 1, "maxLength": 160},
        "status": {"enum": ["completed", "in_progress"]},
        "conclusion": {"oneOf": [{"const": "success"}, {"type": "null"}]}
      }
    },
    "binding": {
      "type": "object", "additionalProperties": false,
      "required": ["run_id", "run_attempt", "artifact_id", "artifact_name", "artifact_digest", "sha256"],
      "properties": {
        "run_id": {"$ref": "#/$defs/runId"},
        "run_attempt": {"const": 1},
        "artifact_id": {"$ref": "#/$defs/runId"},
        "artifact_name": {"type": "string", "minLength": 1, "maxLength": 256},
        "artifact_digest": {"$ref": "#/$defs/digest"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "artifacts": {
      "type": "object", "additionalProperties": false,
      "required": ["acquire_intent", "mutation_intent", "main_lock_proof", "unsigned_receipt", "signed_receipt"],
      "properties": {
        "acquire_intent": {"$ref": "#/$defs/binding"},
        "mutation_intent": {"$ref": "#/$defs/binding"},
        "main_lock_proof": {"$ref": "#/$defs/binding"},
        "unsigned_receipt": {"$ref": "#/$defs/binding"},
        "signed_receipt": {"$ref": "#/$defs/binding"}
      }
    },
    "receiptAttestations": {
      "type": "object", "additionalProperties": false,
      "required": ["signer_workflow", "signer_digest", "source_digest", "source_ref", "runner_environment", "provenance_predicate_type", "policy_predicate_type", "provenance_verification_sha256", "policy_verification_sha256"],
      "properties": {
        "signer_workflow": {"type": "string", "pattern": "^medtechcorps-netizen/whatomate/\\.github/workflows/(apply|rollback)-production-phase\\.yml$"},
        "signer_digest": {"$ref": "#/$defs/sha1"},
        "source_digest": {"$ref": "#/$defs/sha1"},
        "source_ref": {"const": "refs/heads/main"},
        "runner_environment": {"const": "github-hosted"},
        "provenance_predicate_type": {"const": "https://slsa.dev/provenance/v1"},
        "policy_predicate_type": {"type": "string", "pattern": "^https://rereply\\.app/attestations/production-phase-(apply|rollback)-receipt/v1$"},
        "provenance_verification_sha256": {"$ref": "#/$defs/sha256"},
        "policy_verification_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
