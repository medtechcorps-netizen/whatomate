  {"name":"custom_roles","reason":"Existing DirectTenantTableExemptions: role lookup establishes authorization before tenant context; metadata only, no role or membership row reads."},
  {"name":"meta_deauthorization_events","reason":"models.MetaDeauthorizationEvent is a global callback receipt before exact tenant mutations; metadata only, no provider identity or event reads."},
  {"name":"organization_identity_registry","reason":"platform_compliance.go preserves organization identity claims under owner-only privileges and definer guards; metadata only, no identity, role-name or registry row reads."},
  {"name":"organizations","reason":"models.Organization is the tenant identity root used to establish context and control-plane authorization; metadata only, no organization row reads."},
  {"name":"permissions","reason":"models.Permission and SeedPermissionsAndRoles define global resource/action vocabulary; only these public natural keys are hashed, never row IDs or descriptions.","keys":["resource","action"]},
  {"name":"plan_entitlements","reason":"models.PlanEntitlement belongs to the platform/reseller commercial control plane; metadata only, no commercial values or row reads."},
  {"name":"plan_prices","reason":"models.PlanPrice belongs to the platform/reseller commercial control plane; metadata only, no prices, provider data or row reads."},
  {"name":"plans","reason":"models.Plan is explicitly platform- or reseller-owned rather than CRM tenant data; metadata only, no catalog or scope-key row reads."},
  {"name":"reseller_members","reason":"models.ResellerMember grants portfolio control-plane access before materialized tenant membership; metadata only, no user or membership row reads."},
  {"name":"resellers","reason":"models.Reseller is explicitly the commercial control plane spanning organizations; metadata only, no partner or settings row reads."},
  {"name":"role_permissions","reason":"models.RolePermission joins pre-tenant role authorization to the global permission vocabulary; metadata only, no role or permission ID reads."},
  {"name":"sso_providers","reason":"Existing DirectTenantTableExemptions: SSO discovery precedes tenant context; metadata only, no credentials or provider row reads."},
  {"name":"team_members","reason":"models.TeamMember supports existing pre-tenant team authorization; metadata only, no user or membership row reads."},
  {"name":"teams","reason":"Existing DirectTenantTableExemptions: team membership participates in authorization before tenant context; metadata only, no team row reads."},
  {"name":"threads_platform_event_journal","reason":"models.ThreadsPlatformEventJournal is explicitly a global digest-only receipt before tenant resolution; metadata only, no receipt row reads."},
  {"name":"user_organizations","reason":"Existing DirectTenantTableExemptions: membership lookup establishes tenant context; metadata only, no identity or membership row reads."},
  {"name":"users","reason":"Existing DirectTenantTableExemptions: user authentication precedes tenant context; metadata only, no identity, password or user row reads."},
  {"name":"workspace_template_versions","reason":"models.WorkspaceTemplateVersion is a platform/reseller declarative provisioning definition; metadata only, no manifest or template row reads."},
  {"name":"workspace_templates","reason":"models.WorkspaceTemplate defines reusable platform/reseller configuration rather than a tenant application; metadata only, no configuration row reads."}
]
