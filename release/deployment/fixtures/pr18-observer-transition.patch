func main() {
	if len(os.Args) < 2 {
		printUsage()
		os.Exit(1)
	}

	switch os.Args[1] {
	case "server":
		runServer(os.Args[2:])
	case "worker":
		runWorker(os.Args[2:])
	case "rls-migrate":
		runRLSMigration(os.Args[2:])
	case "catalog-snapshot":
		runCatalogSnapshot(os.Args[2:])
	case "seed-klinik-relive-sales":
		runKlinikReliveSalesSeed(os.Args[2:])
	case "bootstrap-platform-compliance":
		runPlatformComplianceBootstrap(os.Args[2:])
	case "version":
		fmt.Printf("ReReply %s (built %s)\n", Version, BuildTime)
	case "help", "-h", "--help":
		printUsage()
	default:
		fmt.Printf("Unknown command: %s\n\n", os.Args[1])
		printUsage()
		os.Exit(1)
	}
}

