+	input.Seeds[2].State = SeedClear
+	input.Seeds[1].State = SeedIncomplete
+	input.Seeds[1].Code = "unavailable"
+	result, err = Plan(context.Background(), input)
+	if err != nil || len(result.SeedDriftIDs) != 0 || len(result.Incomplete) != 2 {
+		t.Fatal(result, err)
