+		requireError(t, err, "transaction")
+		if tx.rowsRead != 0 {
+			t.Fatal("cancelled/nil context queried")
+		}
+	}
+	_, err = CapturePlanInTx(context.Background(), nil, testCatalog())
+	requireError(t, err, "transaction")
+}
