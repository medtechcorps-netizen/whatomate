+			} else {
+				require.Empty(t, result.KnownDrift)
+				require.Empty(t, result.UnknownExcess)
+			}
+			require.Equal(t, before, catalogPlanRows(t, f))
+			require.Equal(t, snapshot, catalogPlanAfterSnapshot(t, f, source))
+		})
+	}
