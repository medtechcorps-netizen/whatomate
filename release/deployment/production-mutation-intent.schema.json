    "lock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "strategy",
        "branch",
        "rule_id",
        "rule_identity_sha256",
        "expected_pre_lock",
        "expected_post_lock",
        "root_acquire_intent",
        "owner_operation",
        "owner_run_id",
        "owner_run_attempt",
        "owner_control_sha",
        "owner_intent_sha256"
      ],
      "properties": {
        "mode": {
          "const": "planned"
        },
        "strategy": {
          "enum": [
            "acquire",
            "inherit"
          ]
        },
        "branch": {
          "const": "main"
        },
        "rule_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_+/=-]+$",
          "maxLength": 512
        },
        "rule_identity_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "expected_pre_lock": {
          "$ref": "#/$defs/lockProjection"
        },
        "expected_post_lock": {
          "allOf": [
            {
              "$ref": "#/$defs/lockProjection"
            },
            {
              "properties": {
                "lock_branch": {
                  "const": true
                }
              }
            }
          ]
        },
        "root_acquire_intent": {
          "$ref": "#/$defs/artifactBinding"
        },
        "owner_operation": {
          "enum": [
            "apply",
            "rollback"
          ]
        },
        "owner_run_id": {
          "$ref": "#/$defs/runId"
        },
        "owner_run_attempt": {
          "$ref": "#/$defs/attempt"
        },
        "owner_control_sha": {
          "$ref": "#/$defs/sha1"
        },
        "owner_intent_sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "strategy"
            ],
            "properties": {
              "strategy": {
                "const": "acquire"
              }
            }
          },
          "then": {
            "properties": {
              "expected_pre_lock": {
                "properties": {
                  "lock_branch": {
                    "const": false
                  }
                }
              },
              "owner_intent_sha256": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "expected_pre_lock": {
                "properties": {
                  "lock_branch": {
                    "const": true
                  }
                }
              },
              "owner_intent_sha256": {
                "$ref": "#/$defs/sha256"
              }
            }
          }
        }
      ]
    },
