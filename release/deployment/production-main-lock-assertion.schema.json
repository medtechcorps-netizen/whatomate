{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rereply.app/schemas/production-main-lock-assertion-v1.json",
  "title": "ReReply production main lock ownership assertion",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "authority",
    "repository",
    "created_at",
    "control",
    "actor_provenance",
    "original_workflow_path",
    "original_control_sha",
    "original_run_id",
    "original_run_attempt",
    "rule_id",
    "rule_identity_sha256",
    "current_main_sha",
    "mutation_intent_sha256",
    "typed_confirmation_sha256",
    "original_provider_job"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "authority": {
      "const": "production-main-lock-ownership-assertion"
    },
    "repository": {
      "const": "medtechcorps-netizen/whatomate"
    },
    "created_at": {
      "$ref": "#/$defs/timestamp"
    },
    "control": {
      "$ref": "#/$defs/control"
    },
    "actor_provenance": {
      "const": "single-operator-assertion-not-audit-log"
    },
    "original_workflow_path": {
      "enum": [
        ".github/workflows/apply-production-phase.yml",
        ".github/workflows/rollback-production-phase.yml",
        ".github/workflows/rollback-production-orphan.yml"
      ]
    },
    "original_control_sha": {
      "$ref": "#/$defs/sha1"
    },
    "original_run_id": {
      "$ref": "#/$defs/runId"
    },
    "original_run_attempt": {
      "const": 1
    },
    "rule_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_+/=-]+$",
      "maxLength": 512
    },
    "rule_identity_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "current_main_sha": {
      "$ref": "#/$defs/sha1"
    },
    "mutation_intent_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "typed_confirmation_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "original_provider_job": {
      "$ref": "#/$defs/originalProviderJob"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "original_workflow_path": {
            "const": ".github/workflows/apply-production-phase.yml"
          }
        },
        "required": ["original_workflow_path"]
      },
      "then": {
        "properties": {
          "original_provider_job": {
            "properties": {
              "job_name": {"const": "Apply exact production phase"},
              "provider_step_name": {"const": "Apply with one isolated app-update capability"}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "original_workflow_path": {
            "const": ".github/workflows/rollback-production-phase.yml"
          }
        },
        "required": ["original_workflow_path"]
      },
      "then": {
        "properties": {
          "original_provider_job": {
            "properties": {
              "job_name": {"const": "Roll back exact production phase"},
              "provider_step_name": {"const": "Roll back with one isolated app-update capability"}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "original_workflow_path": {
            "const": ".github/workflows/rollback-production-orphan.yml"
          }
        },
        "required": ["original_workflow_path"]
      },
      "then": {
        "properties": {
          "original_provider_job": {
            "properties": {
              "job_name": {"const": "Roll back exact production orphan"},
              "provider_step_name": {"const": "Roll back with one inherited-lock app-update capability"}
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha1": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "runId": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,14}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflow_sha",
        "workflow_path",
        "run_id",
        "run_attempt"
      ],
      "properties": {
        "workflow_sha": {
          "$ref": "#/$defs/sha1"
        },
        "workflow_path": {
          "const": ".github/workflows/reconcile-production-orphan.yml"
        },
        "run_id": {
          "$ref": "#/$defs/runId"
        },
        "run_attempt": {
          "const": 1
        }
      }
    },
    "originalProviderJob": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "job_id",
        "job_name",
        "status",
        "conclusion",
        "timing_sha256",
        "step_inventory_sha256",
        "step_count",
        "all_steps_skipped",
        "provider_step_name",
        "provider_step_status",
        "provider_step_conclusion",
        "never_started"
      ],
      "properties": {
        "job_id": {
          "$ref": "#/$defs/runId"
        },
        "job_name": {
          "enum": [
            "Apply exact production phase",
            "Roll back exact production phase",
            "Roll back exact production orphan"
          ]
        },
        "status": {
          "const": "completed"
        },
        "conclusion": {
          "enum": [
            "action_required",
            "cancelled",
            "failure",
            "neutral",
            "skipped",
            "stale",
            "success",
            "timed_out"
          ]
        },
        "timing_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "step_inventory_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "step_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "all_steps_skipped": {
          "type": "boolean"
        },
        "provider_step_name": {
          "enum": [
            "Apply with one isolated app-update capability",
            "Roll back with one isolated app-update capability",
            "Roll back with one inherited-lock app-update capability"
          ]
        },
        "provider_step_status": {
          "type": ["string", "null"],
          "enum": ["queued", "in_progress", "completed", null]
        },
        "provider_step_conclusion": {
          "type": ["string", "null"],
          "enum": [
            "action_required",
            "cancelled",
            "failure",
            "neutral",
            "skipped",
            "stale",
            "success",
            "timed_out",
            null
          ]
        },
        "never_started": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"never_started": {"const": true}},
            "required": ["never_started"]
          },
          "then": {
            "properties": {
              "conclusion": {"const": "skipped"},
              "all_steps_skipped": {"const": true}
            },
            "oneOf": [
              {
                "properties": {
                  "step_count": {"const": 0},
                  "provider_step_status": {"type": "null"},
                  "provider_step_conclusion": {"type": "null"}
                }
              },
              {
                "properties": {
                  "step_count": {"type": "integer", "minimum": 1},
                  "provider_step_status": {"const": "completed"},
                  "provider_step_conclusion": {"const": "skipped"}
                }
              }
            ]
          }
        }
      ]
    }
  }
}
