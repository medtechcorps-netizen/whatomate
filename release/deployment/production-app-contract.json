    "required_token_scopes": [
      "app:read",
      "regions:read",
      "sizes:read",
      "actions:read"
    ]
  },
  "bootstrap_state": {
    "genesis_state_sha256": "c43ed05bc18c2be1c23ab42c85918a821390d39230573780835522481cddcb5d",
    "active_deployment_id_sha256": "df237a5aaafcee1d0bfe57b4b908eeac1c2a1560690e9755b0a38d714326bd44",
    "canonical_spec_sha256": "ff39bee11bc7f4755f7225b287de0d1ea5c24dc349ca563ce837b1c3c4dc3284",
    "environment_values_sha256": "1295999ddf906b9083980f6665b8c3263a03277131f0ccae7a081ac8d3ff1e71",
