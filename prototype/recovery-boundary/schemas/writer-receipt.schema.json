{
  "title": "Gate-C synthetic writer receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "claim_scope", "non_authoritative", "kind", "authority_domain", "generation", "phase", "domain_record_sha256", "source_target_sha256", "recovery_target_sha256", "operation_sha256", "authorization_sha256", "control_sha256", "runtime_source_sha256", "workflow_definition_sha256", "config_sha256", "image_sha256", "app_spec_sha256", "authority_app_sha256", "broker_app_sha256", "ledger_sha256", "root_key_sha256", "signing_kid", "fixed_key_sha256", "marker_sha256", "command", "write_issue_count", "readback_count", "reconciliation", "issued_at", "expires_at", "signature", "signature_sha256"],
  "properties": {
    "schema_version": {"type": "integer", "const": 2},
    "claim_scope": {"type": "string", "const": "gate-c-nonproduction-only"},
    "non_authoritative": {"type": "boolean", "const": true},
    "kind": {"type": "string", "const": "writer-marker-receipt"},
    "authority_domain": {"type": "string", "const": "writer"},
    "generation": {"type": "integer", "minimum": 1, "maximum": 4},
    "phase": {"type": "string", "enum": ["baseline", "bridge", "backend", "ui"]},
    "domain_record_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_target_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "recovery_target_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "operation_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "authorization_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "control_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "runtime_source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "workflow_definition_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "image_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "app_spec_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "authority_app_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "broker_app_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ledger_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "root_key_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "signing_kid": {"type": "string", "pattern": "^synthetic-writer-[0-9a-f]{16}$"},
    "fixed_key_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "marker_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "command": {"type": "string", "const": "FIXED-CAS-THEN-GET"},
    "write_issue_count": {"type": "integer", "const": 1},
    "readback_count": {"type": "integer", "const": 1},
    "reconciliation": {"type": "string", "enum": ["not-needed", "reconciled-one"]},
    "issued_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "expires_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "signature": {"type": "string", "pattern": "^[A-Za-z0-9_-]{86}$"},
    "signature_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
