{
  "title": "Gate-C synthetic signed ledger publication completion",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "claim_scope", "non_authoritative", "kind", "authority_domain", "publication_kind", "generation", "phase", "domain_record_sha256", "operation_body_sha256", "ledger_sha256", "root_key_sha256", "signing_kid", "published_object_sha256", "publication_request_sha256", "publication_result_sha256", "issue_count", "state", "requested_at", "completed_at", "expires_at", "signature", "signature_sha256"],
  "properties": {
    "schema_version": {"type": "integer", "const": 2},
    "claim_scope": {"type": "string", "const": "gate-c-nonproduction-only"},
    "non_authoritative": {"type": "boolean", "const": true},
    "kind": {"type": "string", "const": "ledger-publication-completion"},
    "authority_domain": {"type": "string", "enum": ["writer", "observer"]},
    "publication_kind": {"type": "string", "enum": ["writer-authorization", "observer-admission", "observer-evidence"]},
    "generation": {"type": "integer", "minimum": 1, "maximum": 4},
    "phase": {"type": "string", "enum": ["baseline", "bridge", "backend", "ui"]},
    "domain_record_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "operation_body_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ledger_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "root_key_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "signing_kid": {"type": "string", "pattern": "^synthetic-(writer|observer)-[0-9a-f]{16}$"},
    "published_object_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "publication_request_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "publication_result_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "issue_count": {"type": "integer", "const": 1},
    "state": {"type": "string", "const": "completed"},
    "requested_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "completed_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "expires_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "signature": {"type": "string", "pattern": "^[A-Za-z0-9_-]{86}$"},
    "signature_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
