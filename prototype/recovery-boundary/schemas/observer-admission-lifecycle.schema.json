{
  "title": "Gate-C synthetic observer admission lifecycle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "claim_scope", "non_authoritative", "kind", "authority_domain", "lifecycle_kind", "generation", "phase", "domain_record_sha256", "operation_body_sha256", "source_target_sha256", "recovery_target_sha256", "authorization_sha256", "admission_sha256", "admission_record_sha256", "authority_app_sha256", "broker_app_sha256", "ledger_sha256", "root_key_sha256", "signing_kid", "bound_publication_record_sha256", "lifecycle_request_sha256", "lifecycle_result_sha256", "issue_count", "state", "source_trust_present", "writer_material_present", "recovery_trust_present", "observer_binding_present", "observer_credential_present", "observer_leaf_present", "observer_capability_present", "observer_mtls_present", "requested_at", "completed_at", "issued_at", "expires_at", "signature", "signature_sha256"],
  "properties": {
    "schema_version": {"type": "integer", "const": 2},
    "claim_scope": {"type": "string", "const": "gate-c-nonproduction-only"},
    "non_authoritative": {"type": "boolean", "const": true},
    "kind": {"type": "string", "const": "observer-admission-lifecycle"},
    "authority_domain": {"type": "string", "const": "observer"},
    "lifecycle_kind": {"type": "string", "const": "observer-admission"},
    "generation": {"type": "integer", "minimum": 1, "maximum": 4},
    "phase": {"type": "string", "enum": ["baseline", "bridge", "backend", "ui"]},
    "domain_record_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "operation_body_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_target_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "recovery_target_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "authorization_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "admission_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "admission_record_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "authority_app_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "broker_app_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ledger_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "root_key_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "signing_kid": {"type": "string", "pattern": "^synthetic-observer-[0-9a-f]{16}$"},
    "bound_publication_record_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "lifecycle_request_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "lifecycle_result_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "issue_count": {"type": "integer", "const": 1},
    "state": {"type": "string", "const": "completed"},
    "source_trust_present": {"type": "boolean", "const": false},
    "writer_material_present": {"type": "boolean", "const": false},
    "recovery_trust_present": {"type": "boolean", "const": true},
    "observer_binding_present": {"type": "boolean", "const": true},
    "observer_credential_present": {"type": "boolean", "const": true},
    "observer_leaf_present": {"type": "boolean", "const": true},
    "observer_capability_present": {"type": "boolean", "const": true},
    "observer_mtls_present": {"type": "boolean", "const": true},
    "requested_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "completed_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "issued_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "expires_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "signature": {"type": "string", "pattern": "^[A-Za-z0-9_-]{86}$"},
    "signature_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
