    "writer_ledger_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "writer_root_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "writer_signing_kid": {"type": "string", "pattern": "^synthetic-writer-[0-9a-f]{16}$"},
    "writer_oracle_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "observer_authority_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "observer_broker_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "observer_ledger_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "observer_root_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "observer_oracle_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "boundary_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "claims_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "publication_request_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "writer_signature": {"type": "string", "pattern": "^[A-Za-z0-9_-]{86}$"},
