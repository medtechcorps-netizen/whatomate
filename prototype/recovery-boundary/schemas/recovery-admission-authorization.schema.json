    "terminal_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "fork_request_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "fork_result_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "fork_proof_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "recovery_target_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "fork_provider_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
